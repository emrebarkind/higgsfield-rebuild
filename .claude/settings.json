{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=.claude/hooks/agent-capture.mjs; [ -f \"$CLAUDE_PROJECT_DIR/$f\" ] && f=\"$CLAUDE_PROJECT_DIR/$f\"; node \"$f\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=.claude/hooks/agent-capture.mjs; [ -f \"$CLAUDE_PROJECT_DIR/$f\" ] && f=\"$CLAUDE_PROJECT_DIR/$f\"; node \"$f\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=.claude/hooks/agent-capture.mjs; [ -f \"$CLAUDE_PROJECT_DIR/$f\" ] && f=\"$CLAUDE_PROJECT_DIR/$f\"; node \"$f\" stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
